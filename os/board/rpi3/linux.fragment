CONFIG_ZRAM=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_DRM=y
CONFIG_DRM_VC4=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_TMPFS=y
# Plain .ko modules: busybox modprobe and udev's libkmod are built without xz support
# CONFIG_MODULE_COMPRESS is not set
CONFIG_MODULE_COMPRESS_NONE=y
